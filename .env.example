# Copy this file to .env and fill in real values. .env is git-ignored.
# Every component (Python pipeline, dbt, Express API) reads from this one file.

# ---- PostgreSQL: local development ----
# Used when DATABASE_URL below is empty, which is the normal local setup.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marketpulse
DB_USER=postgres
DB_PASSWORD=change_me

# ---- PostgreSQL: hosted deployment ----
# Hosted providers (Neon, Supabase, Render) hand out a single connection string
# instead of separate parts. When this is set it overrides every DB_* value above,
# and TLS is switched on automatically because those providers refuse plaintext
# connections. Leave it blank for local work.
#
# Both the Python pipeline and the Express API read this same variable, so one
# value points the whole system at the hosted warehouse.
#   DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/marketpulse?sslmode=require
DATABASE_URL=

# ---- Ingestion tuning ----
BACKFILL_DAYS=365
INCREMENTAL_DAYS=7
LOG_LEVEL=INFO

# ---- Express backend ----
PORT=5000
NODE_ENV=development
# Secret used to sign JWTs. Generate a strong random value, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=24h
# Comma-separated list of origins allowed to call the API.
# In the Vercel deployment the API and the frontend share one domain, so no
# cross-origin request is made and this can be left at the local value.
CORS_ORIGIN=http://localhost:5173

# ---- Google sign-in (optional) ----
# OAuth 2.0 Web application client ID from the Google Cloud Console. Leave blank
# to disable the feature: the API reports it as unconfigured and the frontend
# hides the button, so email/password login keeps working untouched.
# The same value is served to the browser by GET /api/auth/config, so the
# frontend needs no separate copy of it. There is no client secret, because the
# browser uses Google Identity Services and the API only verifies the ID token.
GOOGLE_CLIENT_ID=


# ---- React frontend (Vite requires the VITE_ prefix) ----
# Absolute URL locally, because Vite (5173) and Express (5000) are separate
# servers. When deployed both are served from the same domain, so the frontend
# uses the relative path /api and this variable is left unset in Vercel.
VITE_API_BASE_URL=http://localhost:5000/api
